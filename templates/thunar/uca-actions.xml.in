<actions>
  <action>
    <icon>archive-insert</icon>
    <name>@L_COMPRESS_DIALOG@</name>
    <submenu>7-Zip</submenu>
    <unique-id>7zctx-compress-dialog</unique-id>
    <command>@HELPER_SH_QUOTED@ compress-dialog %F</command>
    <description>7-Zip</description>
    <patterns>*</patterns>
    <directories/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>
  <action>
    <icon>archive-insert</icon>
    <name>@L_COMPRESS_7Z@</name>
    <submenu>7-Zip</submenu>
    <unique-id>7zctx-compress-7z</unique-id>
    <command>@HELPER_SH_QUOTED@ compress 7z --ask %F</command>
    <description>7-Zip</description>
    <patterns>*</patterns>
    <directories/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>
  <action>
    <icon>archive-insert</icon>
    <name>@L_COMPRESS_ZIP@</name>
    <submenu>7-Zip</submenu>
    <unique-id>7zctx-compress-zip</unique-id>
    <command>@HELPER_SH_QUOTED@ compress zip --ask %F</command>
    <description>7-Zip</description>
    <patterns>*</patterns>
    <directories/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>
  <action>
    <icon>archive-insert</icon>
    <name>@L_COMPRESS_TARGZ@</name>
    <submenu>7-Zip</submenu>
    <unique-id>7zctx-compress-targz</unique-id>
    <command>@HELPER_SH_QUOTED@ compress tar.gz --ask %F</command>
    <description>7-Zip</description>
    <patterns>*</patterns>
    <directories/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>
  <action>
    <icon>archive-extract</icon>
    <name>@L_EXTRACT_HERE@</name>
    <submenu>7-Zip</submenu>
    <unique-id>7zctx-extract-here</unique-id>
    <command>@HELPER_SH_QUOTED@ extract-here %F</command>
    <description>7-Zip</description>
    <patterns>@PATTERNS@</patterns>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>
  <action>
    <icon>archive-extract</icon>
    <name>@L_EXTRACT_TO@</name>
    <submenu>7-Zip</submenu>
    <unique-id>7zctx-extract-to</unique-id>
    <command>@HELPER_SH_QUOTED@ extract-to %F</command>
    <description>7-Zip</description>
    <patterns>@PATTERNS@</patterns>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>
  <action>
    <icon>dialog-ok</icon>
    <name>@L_TEST@</name>
    <submenu>7-Zip</submenu>
    <unique-id>7zctx-test</unique-id>
    <command>@HELPER_SH_QUOTED@ test %F</command>
    <description>7-Zip</description>
    <patterns>@PATTERNS@</patterns>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>
  <action>
    <icon>view-list-text</icon>
    <name>@L_LIST@</name>
    <submenu>7-Zip</submenu>
    <unique-id>7zctx-list</unique-id>
    <command>@HELPER_SH_QUOTED@ list %F</command>
    <description>7-Zip</description>
    <patterns>@PATTERNS@</patterns>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>
</actions>
