# Estado global
# --------------------------------------------------------------------------
RS=$'\x1f'                    # separador interno dos resultados
PROBE_PW="__7zctx_probe__"    # senha sentinela usada só para detectar criptografia
PW_MAX=3                      # tentativas de senha por arquivo

TMPD=""
