LANG_SEL="en"
SHARE_DIR=""
LOG_FILE=""
STDBUF=()
EXT_PATTERNS=()
MIME_TYPES=()

ACTION=""
ITEMS=()
RESULTS=()
OVERALL=0
CANCELLED=0
PARTIAL=()                    # saídas parciais a apagar se o helper for interrompido

JOB_SEQ=0
JOB_RC=0
JOB_CANCELLED=0
JOB_ERRF=""
JOB_PIDS=()
PROG_IDX=0
PROG_N=1

UI_PROG_PID=""
UI_PROG_ACTIVE=0
UI_KSVC=""
UI_KPATH=""
UI_PW_CALLS=0
UI_PROG_LABEL=""
UI_PROG_T0=0

PW_TRIES=0
PW_RESULT=""
PW_NEED="none"
PROBE_OUT=""
ERRTXT=""
REPLY=""

