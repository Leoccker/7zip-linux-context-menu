#!/usr/bin/env bash
# 7z-context-helper - ponto único de lógica do menu de contexto 7-Zip.
#
# Os arquivos de integração de cada explorador só chamam:
#     7z-context-helper <ação> [opções] <arquivos...>
# Ver "7z-context-helper --help" e o README.md.
#
# Requer Bash 4+, 7-Zip (7zz, 7z ou 7za) e, opcionalmente, kdialog, zenity,
# yad ou notify-send para a interface gráfica.

set -u

CTX7Z_VERSION="1.0.0"
APP_TITLE="7-Zip"

if (( BASH_VERSINFO[0] < 4 )); then
  echo "7z-context-helper: Bash 4 or newer is required." >&2
  exit 1
fi

